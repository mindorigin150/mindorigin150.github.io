---
import { getCollection } from 'astro:content';
import ResearchEntry from '../../components/ResearchEntry.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const research = (await getCollection('research', ({ data }) => !data.draft))
  .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Research — Xinyuan Li"
  description="Research by Xinyuan Li at the intersection of multimodal agents and efficient AI systems."
>
  <main id="main-content" class="page-main site-shell inner-page">
    <a class="back-link" href="/"><span aria-hidden="true">←</span> Xinyuan Li</a>
    <header class="page-intro">
      <h1>Research</h1>
      <p>
        My research lies at the intersection of multimodal agents and efficient AI systems—studying how
        foundation models operate in dynamic, real-world environments, and building the systems that make
        training and deploying them fast and reliable.
      </p>
    </header>

    <section class="indexed-section" aria-labelledby="research-output-title">
      <div class="section-heading">
        <h2 id="research-output-title">Publications & Projects</h2>
      </div>
      <div class="research-list">
        {research.map((entry) => <ResearchEntry entry={entry} />)}
      </div>
    </section>
  </main>
</BaseLayout>
