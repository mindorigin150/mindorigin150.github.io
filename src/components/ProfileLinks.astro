---

<ul class="profile-links" aria-label="Contact and profile links">
  {
    siteConfig.profileLinks.map((link) => (
      <li>
        <a href={link.href} aria-label={link.label} title={link.label}>
          {link.label === 'Google Scholar' ? (
            <GoogleScholarIcon viewBox="0 64 384 384" width="22" height="22" aria-hidden="true" focusable="false" />
          ) : (
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true" focusable="false">
              <path d={icons[link.label]} />
            </svg>
          )}
        </a>
      </li>
    ))
  }
</ul>
